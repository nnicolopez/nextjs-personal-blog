# Copy to .env.local (never commit it). On Vercel, set these in
# Project Settings > Environment Variables.

# Neon: create a project at neon.tech and copy the connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (web application)
# Authorized JavaScript origins:  http://localhost:3000 and https://YOUR-APP.vercel.app
# Authorized redirect URIs:       http://localhost:3000/api/auth/callback/google
#                                 https://YOUR-APP.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."

# openssl rand -base64 32
AUTH_SECRET="..."

# Only these emails can sign in, comma separated. Empty = nobody gets in.
ALLOWED_EMAILS="you@gmail.com"
